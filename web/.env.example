# Copy to .env.local and fill in. Leave the Supabase values empty to run in demo mode
# (sample data from shared/seed/catalog.json, orders kept in the browser, simulated payment).

# Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this one to the browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe -> Developers -> API keys (use test keys until launch)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Stripe -> Developers -> Webhooks -> endpoint /api/payments/webhook
STRIPE_WEBHOOK_SECRET=
